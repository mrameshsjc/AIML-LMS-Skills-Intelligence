.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.idea
.vscode
.env
.env.*
# data: only the synthetic sample is copied into the image
data/*
!data/sample
models
vector_store
mlruns
tests
reports
docs
*.md
!documents/*.md
logs
