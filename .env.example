# Copy this file to .env and adjust values:
#   PS> Copy-Item .env.example .env
# .env is git-ignored. NEVER put real passwords or keys in .env.example.

APP_ENV=development          # development | test | production
APP_PROFILE=local            # local | compose | public-demo
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# Folder with the LMS CSV files the API serves (data/sample or data/processed)
DATA_DIR=data/sample

# Where the API reads data: csv (the files in DATA_DIR) or database (DATABASE_URL)
# Create the database first: python data_science/14_save_to_database.py
DATA_SOURCE=csv

# Completion model for API 3 (train it with: python data_science/11_train_model.py)
MODEL_DIR=models
USE_COMPLETION_MODEL=true

# Language model (Phase 11). auto = Ollama when running, else a labelled no-LLM fallback.
# Install Ollama (https://ollama.com/download), then: ollama pull llama3.2:3b
LLM_PROVIDER=auto              # auto | ollama | fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120        # the first request loads the model and can be slow
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_ALLOW_REMOTE=false         # true only if sending data to a non-local LLM host is approved

# Knowledge documents and search (Phase 12). Build the index: python scripts/build_index.py
DOCUMENTS_DIR=documents
VECTOR_STORE_DIR=vector_store
RAG_TENANT=default
EMBEDDING_PROVIDER=auto        # auto (Ollama if nomic-embed-text is installed, else TF-IDF) | ollama | tfidf
OLLAMA_EMBED_MODEL=nomic-embed-text
VECTOR_BACKEND=auto            # auto (FAISS if installed) | faiss | numpy
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
# Phase 13: the assistant and document uploads
RAG_UPLOAD_DIR=data/uploads/documents
RAG_MAX_UPLOAD_MB=10
RAG_MIN_SCORE=                 # empty = by embedder (TF-IDF 0.08, Ollama 0.45)

# SQLite database file (Phase 9). Only sqlite:/// URLs are supported in this version;
# MySQL is planned for a later phase.
DATABASE_URL=sqlite:///./data/lms_ai.db
