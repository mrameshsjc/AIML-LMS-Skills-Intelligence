# Copy this file to .env and adjust values:
#   PS> Copy-Item .env.example .env
# .env is git-ignored. NEVER put real passwords or keys in .env.example.

APP_ENV=development          # development | test | production
APP_PROFILE=local            # local | compose | public-demo
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# Folder with the LMS CSV files the API serves (data/sample or data/processed)
DATA_DIR=data/sample

# Where the API reads data: csv (the files in DATA_DIR) or database (DATABASE_URL)
# Create the database first: python data_science/14_save_to_database.py
DATA_SOURCE=csv

# Completion model for API 3 (train it with: python data_science/11_train_model.py)
MODEL_DIR=models
USE_COMPLETION_MODEL=true

# Language model (Phase 11). auto = Ollama when running, else a labelled no-LLM fallback.
# Install Ollama (https://ollama.com/download), then: ollama pull llama3.2:3b
LLM_PROVIDER=auto              # auto | ollama | fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120        # the first request loads the model and can be slow
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_ALLOW_REMOTE=false         # true only if sending data to a non-local LLM host is approved

# Knowledge documents and search (Phase 12). Build the index: python scripts/build_index.py
DOCUMENTS_DIR=documents
VECTOR_STORE_DIR=vector_store
RAG_TENANT=default
EMBEDDING_PROVIDER=auto        # auto (Ollama if nomic-embed-text is installed, else TF-IDF) | ollama | tfidf
OLLAMA_EMBED_MODEL=nomic-embed-text
VECTOR_BACKEND=auto            # auto (FAISS if installed) | faiss | numpy
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
# Phase 13: the assistant and document uploads
RAG_UPLOAD_DIR=data/uploads/documents
RAG_MAX_UPLOAD_MB=10
# RAG_MIN_SCORE: empty = by embedder (TF-IDF 0.08, Ollama 0.45)
RAG_MIN_SCORE=

# Administration and retraining (Phase 16). Admin actions (API 6 retraining, API 7 uploads/deletes) need
# this key in the X-Admin-Key header - or, with login on, an administrator's login.
# Empty = the key is not accepted (with login off, admin actions are then switched off). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
ML_MIN_ROC_AUC=0.60            # quality gate: the new model must reach this test ROC AUC
ML_MAX_REGRESSION=0.01         # quality gate: allowed drop compared with the current model
ML_MIN_TRAINING_ROWS=200
MLFLOW_ENABLED=auto            # auto (if installed) | true | false
# MLFLOW_TRACKING_URI: empty = sqlite file mlruns/mlflow.db in the project folder
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=completion-model

# SQLite database file (Phase 9). Only sqlite:/// URLs are supported in this version;
# MySQL is planned for a later phase.
DATABASE_URL=sqlite:///./data/lms_ai.db

# NOTE: an empty value must not have a comment on the same line (KEY=  # x would read "# x").
# --- Security (Phase 17) - docs/SECURITY_GUIDE.md ----------------------------------------------------
# Login. false = local development: every endpoint is open (synthetic data, your own PC only).
# APP_PROFILE=public-demo or APP_ENV=production REFUSE to start with AUTH_ENABLED=false.
AUTH_ENABLED=false
# Signs the login tokens; at least 32 characters, never commit it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_MINUTES=60
USERS_FILE=data/users.json       # accounts: python scripts/create_user.py (git-ignored)
# Rate limits (0 = no limit). Per IP address (per user for the assistant).
RATE_LIMIT_PER_MINUTE=120        # every /api/v1 request except health checks
RATE_LIMIT_CHAT_PER_MINUTE=20    # the assistant (API 5) calls a language model
RATE_LIMIT_ADMIN_PER_HOUR=10     # retraining, uploads, deletes (also slows down key guessing)
AUDIT_LOG_FILE=logs/audit.jsonl  # who did what (never request bodies); empty = off
# CORS_ORIGINS: browser sites allowed to call the API, comma-separated; empty = none
CORS_ORIGINS=
BLOCK_PROMPT_INJECTION=true      # refuse questions/uploads that try to override the assistant's rules
