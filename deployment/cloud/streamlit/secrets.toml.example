# Streamlit Community Cloud -> your app -> Settings -> Secrets: paste THIS (with your own values).
# Root-level keys become environment variables, which the engine's settings read (Phase 19).
# Never commit real values: this file is an example only.

APP_PROFILE = "public-demo"
AUTH_ENABLED = "true"
GUEST_ACCESS = "true"
PREPARE_IN_DASHBOARD = "true"
PREPARE_TRAIN_MODEL = "true"
EMBEDDING_PROVIDER = "tfidf"
VECTOR_BACKEND = "numpy"
LLM_PROVIDER = "fallback"
MLFLOW_ENABLED = "false"
RATE_LIMIT_CHAT_PER_MINUTE = "10"
RAG_MAX_UPLOAD_MB = "2"

# Secrets - generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   (AUTH_SECRET_KEY)
#   python -c "import secrets; print(secrets.token_urlsafe(16))"   (BOOTSTRAP_ADMIN_PASSWORD, keep it private)
AUTH_SECRET_KEY = "paste-a-48-character-secret-here"
BOOTSTRAP_ADMIN_PASSWORD = "paste-your-private-admin-password"
