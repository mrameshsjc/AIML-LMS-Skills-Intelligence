# Copy to secret.env (git-ignored), put your own values, then create the Kubernetes Secret:
#   PS> Copy-Item deployment/kubernetes/secret.example.env deployment/kubernetes/secret.env
#   PS> kubectl -n lms-skills create secret generic lms-secrets --from-env-file=deployment/kubernetes/secret.env
# Generate values: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace-with-a-48-character-secret
BOOTSTRAP_ADMIN_PASSWORD=replace-with-your-admin-password
ADMIN_API_KEY=replace-with-an-admin-api-key
